# Generate a NEW key for each deployment; never commit its value.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
PRODUCTION=False
SECRET_KEY=

# Product photos: set this on PWS so uploads survive redeploys (Cloudinary dashboard >
# API environment variable, format cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# Leave empty locally to keep photos in the media/ folder.
CLOUDINARY_URL=

# Salin file ini jadi .env lalu isi dengan credential dari Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local runserver uses HTTP. Leave unset or use https on PWS.
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# Default development backend prints verification/reset links in the server terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email delivery, use django.core.mail.backends.smtp.EmailBackend and fill:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GAIA <noreply@gaia.local>

# Optional: ID of an active staff account provisioned by the administrator.
GAIA_CARE_USER_ID=
GAIA_CARE_USERNAME=gaiacare
