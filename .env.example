# Salin file ini jadi .env lalu isi dengan credential dari Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Default development backend prints verification/reset links in the server terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email delivery, use django.core.mail.backends.smtp.EmailBackend and fill:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GAIA <noreply@gaia.local>
